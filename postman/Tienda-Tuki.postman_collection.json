{
  "info": {
    "name": "Tienda Tuki API",
    "description": "Coleccion para probar el CRUD, carrito, resumen y checkout de Tienda Tuki.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "token_expirado", "value": "" },
    { "key": "email", "value": "ana@example.com" },
    { "key": "categoria_id", "value": "1" },
    { "key": "producto_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        { "name": "Registro exitoso", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ana Perez\",\n  \"email\": \"{{email}}\",\n  \"password\": \"password-segura\",\n  \"password_confirmation\": \"password-segura\"\n}" }, "url": "{{base_url}}/auth/register" }, "response": [{ "name": "Usuario registrado", "status": "Created", "code": 201, "body": "{\n  \"mensaje\": \"Usuario registrado correctamente\",\n  \"token\": \"eyJ...\",\n  \"tipo_token\": \"Bearer\"\n}" }] },
        { "name": "Login exitoso", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password-segura\"\n}" }, "url": "{{base_url}}/auth/login" }, "response": [{ "name": "Login correcto", "status": "OK", "code": 200, "body": "{\n  \"mensaje\": \"Login realizado correctamente\",\n  \"token\": \"eyJ...\",\n  \"tipo_token\": \"Bearer\"\n}" }] },
        { "name": "Login con credenciales incorrectas", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"incorrecta\"\n}" }, "url": "{{base_url}}/auth/login" }, "response": [{ "name": "Credenciales incorrectas", "status": "Unauthorized", "code": 401, "body": "{\n  \"mensaje\": \"Las credenciales son incorrectas\"\n}" }] },
        { "name": "Registro con datos inválidos", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"email\": \"correo-invalido\",\n  \"password\": \"corta\",\n  \"password_confirmation\": \"distinta\"\n}" }, "url": "{{base_url}}/auth/register" }, "response": [{ "name": "Error de validación", "status": "Unprocessable Entity", "code": 422, "body": "{\n  \"mensaje\": \"Error de validación\",\n  \"errores\": {\n    \"email\": [\"El email debe tener un formato válido.\"],\n    \"password\": [\"La contraseña debe tener al menos 8 caracteres.\"]\n  }\n}" }] },
        { "name": "Registro con email duplicado", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ana Perez\",\n  \"email\": \"{{email}}\",\n  \"password\": \"password-segura\",\n  \"password_confirmation\": \"password-segura\"\n}" }, "url": "{{base_url}}/auth/register" }, "response": [{ "name": "Email ya registrado", "status": "Unprocessable Entity", "code": 422, "body": "{\n  \"mensaje\": \"Error de validación\",\n  \"errores\": {\n    \"email\": [\"El email ya está registrado.\"]\n  }\n}" }] },
        { "name": "Carrito sin JWT", "request": { "method": "GET", "url": "{{base_url}}/carrito" }, "response": [{ "name": "Token requerido", "status": "Unauthorized", "code": 401, "body": "{\n  \"mensaje\": \"El token no existe, es inválido o expiró.\"\n}" }] },
        { "name": "Carrito con JWT inválido", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer token-invalido" }], "url": "{{base_url}}/carrito" }, "response": [{ "name": "Token inválido", "status": "Unauthorized", "code": 401, "body": "{\n  \"mensaje\": \"El token no existe, es inválido o expiró.\"\n}" }] },
        { "name": "Carrito con JWT expirado", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token_expirado}}" }], "url": "{{base_url}}/carrito" }, "response": [{ "name": "Token expirado", "status": "Unauthorized", "code": 401, "body": "{\n  \"mensaje\": \"El token no existe, es inválido o expiró.\"\n}" }] }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        { "name": "Listar categorias", "request": { "method": "GET", "url": "{{base_url}}/categorias" } },
        { "name": "Obtener categoria", "request": { "method": "GET", "url": "{{base_url}}/categorias/{{categoria_id}}" } },
        { "name": "Obtener categoria inexistente", "request": { "method": "GET", "url": "{{base_url}}/categorias/999999" }, "response": [{ "name": "Categoria no encontrada", "status": "Not Found", "code": 404, "body": "{\n  \"mensaje\": \"Categoría no encontrada\"\n}" }] },
        { "name": "Crear categoria", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Accesorios\"\n}" }, "url": "{{base_url}}/categorias" }, "response": [{ "name": "Categoria creada", "status": "Created", "code": 201, "body": "{\n  \"mensaje\": \"Categoría creada correctamente\",\n  \"categoria\": {\n    \"id\": 1,\n    \"nombre\": \"Accesorios\"\n  }\n}" }] },
        { "name": "Actualizar categoria", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Accesorios actualizados\"\n}" }, "url": "{{base_url}}/categorias/{{categoria_id}}" } },
        { "name": "Eliminar categoria", "request": { "method": "DELETE", "url": "{{base_url}}/categorias/{{categoria_id}}" } }
      ]
    },
    {
      "name": "Productos",
      "item": [
        { "name": "Listar productos", "request": { "method": "GET", "url": "{{base_url}}/productos" } },
        { "name": "Obtener producto", "request": { "method": "GET", "url": "{{base_url}}/productos/{{producto_id}}" } },
        { "name": "Crear producto", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Producto Postman\",\n  \"descripcion\": \"Producto de prueba\",\n  \"precio\": 8500,\n  \"stock\": 10,\n  \"color\": \"Negro\",\n  \"categoria_id\": {{categoria_id}}\n}" }, "url": "{{base_url}}/productos" }, "response": [{ "name": "Producto creado", "status": "Created", "code": 201, "body": "{\n  \"mensaje\": \"Producto creado correctamente\",\n  \"producto\": {\n    \"id\": 1,\n    \"nombre\": \"Producto Postman\",\n    \"stock\": 10\n  }\n}" }] },
        { "name": "Actualizar producto", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Producto actualizado\",\n  \"descripcion\": \"Producto modificado\",\n  \"precio\": 9000,\n  \"stock\": 15,\n  \"color\": \"Negro\",\n  \"categoria_id\": {{categoria_id}}\n}" }, "url": "{{base_url}}/productos/{{producto_id}}" } },
        { "name": "Eliminar producto", "request": { "method": "DELETE", "url": "{{base_url}}/productos/{{producto_id}}" } },
        { "name": "Crear producto con datos inválidos", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"\",\n  \"precio\": -100,\n  \"stock\": -1\n}" }, "url": "{{base_url}}/productos" }, "response": [{ "name": "Error de validación", "status": "Unprocessable Entity", "code": 422, "body": "{\n  \"mensaje\": \"Error de validación\",\n  \"errores\": {\n    \"nombre\": [\"El nombre del producto es obligatorio.\"],\n    \"precio\": [\"El precio no puede ser negativo.\"],\n    \"stock\": [\"El stock no puede ser negativo.\"]\n  }\n}" }] }
      ]
    },
    {
      "name": "Carrito",
      "item": [
        { "name": "Ver carrito", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/carrito" } },
        { "name": "Agregar item", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"producto_id\": {{producto_id}},\n  \"cantidad\": 2\n}" }, "url": "{{base_url}}/carrito/items" }, "response": [{ "name": "Item agregado", "status": "Created", "code": 201, "body": "{\n  \"mensaje\": \"Producto agregado al carrito\"\n}" }] },
        { "name": "Actualizar cantidad", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"cantidad\": 3\n}" }, "url": "{{base_url}}/carrito/items/{{producto_id}}" } },
        { "name": "Eliminar item", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/carrito/items/{{producto_id}}" } },
        { "name": "Eliminar item inexistente", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/carrito/items/999999" }, "response": [{ "name": "Producto no está en el carrito", "status": "Not Found", "code": 404, "body": "{\n  \"mensaje\": \"El producto no está en el carrito\"\n}" }] },
        { "name": "Vaciar carrito", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/carrito" } },
        { "name": "Ver resumen", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/carrito/resumen" }, "response": [{ "name": "Resumen calculado", "status": "OK", "code": 200, "body": "{\n  \"mensaje\": \"Resumen del carrito obtenido correctamente\",\n  \"resumen\": {\n    \"subtotal\": 17000,\n    \"impuestos\": 3570,\n    \"envio\": 5000,\n    \"total\": 25570\n  }\n}" }] }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        { "name": "Checkout sin JWT", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre_destinatario\": \"Ana Perez\",\n  \"direccion\": \"Calle 123\",\n  \"ciudad\": \"Buenos Aires\",\n  \"metodo_pago\": \"tarjeta\"\n}" }, "url": "{{base_url}}/checkout/confirmar" }, "response": [{ "name": "Token requerido", "status": "Unauthorized", "code": 401, "body": "{\n  \"mensaje\": \"El token no existe, es inválido o expiró.\"\n}" }] },
        { "name": "Revisar compra", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/checkout/revisar" } },
        { "name": "Confirmar compra", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"nombre_destinatario\": \"Ana Perez\",\n  \"direccion\": \"Calle 123\",\n  \"ciudad\": \"Buenos Aires\",\n  \"metodo_pago\": \"tarjeta\"\n}" }, "url": "{{base_url}}/checkout/confirmar" }, "response": [{ "name": "Compra confirmada", "status": "Created", "code": 201, "body": "{\n  \"mensaje\": \"Compra confirmada correctamente\",\n  \"pedido\": {\n    \"id\": 1,\n    \"total\": 25570,\n    \"estado\": \"confirmado\"\n  }\n}" }] }
      ]
    }
  ]
}
